<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.einthusan" name="Einthusan" version="3.0" provider-name="KAddons">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.22.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary>Einthusan Video Addon - Updated</summary>
        <description>Einthusan Video Addon for new Kodi with Python 3</description>
        <assets>
            <icon>icon.png</icon>
            <fanart>icon.png</fanart>
        </assets>
    </extension>
</addon>

<addon id="repository.kaddons" name="KAddons Kodi Repository" version="1.1.0" provider-name="KAddons">
    <extension point="xbmc.addon.repository" name="KAddons Kodi Repository">
        <dir>
            <info compressed="false">https://github.com/rmokate2023/kaddons/raw/main/zips/addons.xml</info>
            <checksum>https://github.com/rmokate2023/kaddons/raw/main/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://github.com/rmokate2023/kaddons/raw/main/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>KAddons Kodi Repository</summary>
        <description>https://github.com/rmokate2023/kaddons/</description>
        <website>https://rmokate2023.github.io/</website>
        <platform>all</platform>
    </extension>
</addon>
</addons>
